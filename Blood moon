-- Đổi màu các hiệu ứng hỗ trợ
local function applyEffect(object)
    local property

    if object:IsA("ParticleEmitter")
    or object:IsA("Trail")
    or object:IsA("Beam") then
        property = "Color"
    elseif object:IsA("Fire")
    or object:IsA("Smoke")
    or object:IsA("Sparkles") then
        property = "Color"
    elseif object:IsA("PointLight")
    or object:IsA("SpotLight")
    or object:IsA("SurfaceLight") then
        property = "Color"
    end

    if not property then return end

    if not tracked[object] then
        local ok, original = pcall(function()
            return object[property]
        end)

        if not ok then return end

        tracked[object] = {
            property = property,
            original = original
        }
    end

    pcall(function()
        local data = tracked[object]

        if enabled then
            object[property] = ColorSequence.new(RED)
        else
            object[property] = data.original
        end
    end)
end

local function updateEffects()
    for object in pairs(tracked) do
        if object.Parent then
            applyEffect(object)
        end
    end
end

local function updateUI()
    status.Text = enabled and "Trạng thái: Đang bật"
        or "Trạng thái: Đang tắt"

    toggle.Text = enabled and "TẮT HIỆU ỨNG"
        or "BẬT HIỆU ỨNG"

    updateEffects()
end

-- Theo dõi hiệu ứng mới
for _, object in ipairs(Workspace:GetDescendants()) do
    applyEffect(object)
end

Workspace.DescendantAdded:Connect(function(object)
    if enabled then
        applyEffect(object)
    end
end)

-- Nút bật tắt hiệu ứng
toggle.Activated:Connect(function()
    enabled = not enabled
    updateUI()
end)

-- Logo bật và ẩn bảng theo từng lần nhấn
